# Set to "true" to call the Anthropic API for poster-side project scoping.
# Anything else (default) streams pre-written briefs.
USE_REAL_AI=false
# Only read when USE_REAL_AI=true. Put the real key in .env.local, never commit it.
ANTHROPIC_API_KEY=
# Optional model override
ANTHROPIC_MODEL=claude-sonnet-5-5
# Set to "true" to check credentials against real issuer pages (allowlisted hosts only, https only).
# Default mock mode uses the demo credentials listed on each certification page.
USE_REAL_VERIFY=false
