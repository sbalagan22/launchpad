# Set to "true" to call the Anthropic API for AI scoping and proposal drafting.
# Anything else (default) returns pre-written responses with a streaming effect.
USE_REAL_AI=false
# Only read when USE_REAL_AI=true. Put the real key in .env.local, never commit it.
ANTHROPIC_API_KEY=
# Optional model override
ANTHROPIC_MODEL=claude-sonnet-5-5
